#!/bin/sh /etc/rc.common
# NonsPlayer Playlist Sync Service for OpenWrt (procd)
START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
SCRIPT_DIR=/etc/nons-sync
SCRIPT=$SCRIPT_DIR/server.py
DB_FILE=$SCRIPT_DIR/nons_playlists.db
PORT=17777

start_service() {
    procd_open_instance
    procd_set_param command $PROG $SCRIPT --host 0.0.0.0 --port $PORT --db $DB_FILE
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
